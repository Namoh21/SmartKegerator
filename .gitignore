# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Database & runtime data
*.db
*.db-shm
*.db-wal

# Runtime logs and exported data
logs/

# User photos and media (large binary data — store separately)
photos/
videos/

# config.yaml is generated by install.sh from config.yaml.example
# Never track it — git pull would reset user-specific paths
src/config.yaml

# Session secret — auto-generated on first run, must not be in version control
src/web/.session_secret

# Claude Code local settings (tool-specific, may contain local paths/IPs)
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Old SVN metadata
.svn/

# Old C++ build artifacts (legacy — source files kept in git history)
*.o
*.so
Makefile.Debug
Makefile.Release
