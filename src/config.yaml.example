taps:
  count: 3          # number of active taps: 1, 2, 3, or 4
  tap1:
    name: Left      # display name shown in the UI
    pin: 23         # BCM GPIO pin for this flow meter
  tap2:
    name: Center
    pin: 24
  tap3:
    name: Right
    pin: 25
  tap4:
    name: Tap 4
    pin: null       # null = not connected / not used

hardware:
  # Camera
  camera_index: 0
  camera_width: 640
  camera_height: 480
  camera_use_color: true
  camera_leds_pin: 18

  # Flow meter calibration (shared across all taps)
  ticks_per_liter: 500
  tick_threshold: 3          # ticks required before a pour is registered
  end_pour_seconds: 5.0      # seconds of no ticks before pour ends

  # Temperature sensors
  temp_sensor_power_pin: 17
  temp_sensor_dht_pin: 22
  liquid_temp_sensor_id: "28-0000058cffde"   # DS18B20 1-Wire device ID

recognition:
  enabled: true
  confidence_threshold: 0.55   # lower = stricter (face_recognition distance metric)
  detection_model: "hog"       # "hog" (faster, CPU) or "cnn" (accurate, needs more CPU)

data:
  database_path: /opt/smartkegerator/smartkegerator.db
  user_photos_dir: /opt/smartkegerator/photos
  pour_videos_dir: /opt/smartkegerator/videos
  beer_logos_dir: /opt/smartkegerator/logos

display:
  rotate: 1          # 1=90°CW (portrait), 0=normal landscape, 2=180°, 3=270°
                     # Applied by scripts/install.sh — reboot required

ui:
  fullscreen: true   # set false only for desktop development/testing
  window_x: 500
  window_y: 200
  css_file: /opt/smartkegerator/style.css
  beer_logo_opacity: 0.5
  pour_video_frame_rate: 20
  log_pours: true

web:
  port: 8080    # web interface port — accessible at http://<pi-ip>:8080

admin:
  password: "1234"
