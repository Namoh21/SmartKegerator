taps:
  count: 3          # number of active taps: 1, 2, 3, or 4
  tap1:
    name: Left      # display name shown in the UI
    pin: 23         # BCM GPIO pin for this flow meter
  tap2:
    name: Center
    pin: 24
  tap3:
    name: Right
    pin: 25
  tap4:
    name: Tap 4
    pin: null       # null = not connected / not used

hardware:
  # Camera
  camera_index: 0
  camera_width: 640
  camera_height: 480
  camera_use_color: true
  camera_swap_red_blue: false  # swap R↔B channels — enable if red objects appear blue
  camera_mirror: true         # flip preview horizontally (mirror effect for user positioning)
  camera_leds_pin: 18

  # Flow meter calibration (shared across all taps)
  ticks_per_liter: 500
  tick_threshold: 3          # ticks required before a pour is registered
  end_pour_seconds: 5.0      # seconds of no ticks before pour ends

  # GPIO chip device — auto-detected by setup_hardware.sh at install time
  # Pi 5: /dev/gpiochip4 (RP1 chip)   Pi 3/4: /dev/gpiochip0
  gpio_chip: /dev/gpiochip0

  # Temperature / humidity sensor
  # "aht20" — recommended for all Pi models (I2C, no pull-up resistor needed)
  #            Wiring: VCC→3.3V  SDA→GPIO2 (pin 3)  SCL→GPIO3 (pin 5)  GND→GND
  # "dht22" — legacy bit-bang sensor, Pi 3/4 only (NOT supported on Pi 5)
  #            Wiring: VCC→3.3V  Data→GPIO22 + 4.7kΩ pull-up to 3.3V  GND→GND
  temp_sensor_type: "aht20"
  temp_sensor_power_pin: 17   # DHT22 only: GPIO pin to power-cycle sensor on error
  temp_sensor_dht_pin: 22     # DHT22 only: GPIO data pin

recognition:
  enabled: true
  confidence_threshold: 0.55   # lower = stricter (face_recognition distance metric)
  detection_model: "hog"       # "hog" (faster, CPU) or "cnn" (accurate, needs more CPU)

data:
  database_path: /opt/smartkegerator/smartkegerator.db
  user_photos_dir: /opt/smartkegerator/photos
  pour_videos_dir: /opt/smartkegerator/videos
  beer_logos_dir: /opt/smartkegerator/logos

display:
  rotation: 0        # degrees: 0=no rotation, 90, 180, 270
                     # Configurable in web Settings → Appearance. Reboot required.

ui:
  fullscreen: true   # set false only for desktop development/testing
  window_x: 500
  window_y: 200
  css_file: /opt/smartkegerator/style.css
  beer_logo_opacity: 0.5
  pour_video_frame_rate: 20
  log_pours: true

web:
  port: 8080    # web interface port — accessible at http://<pi-ip>:8080

admin:
  password: "1234"
