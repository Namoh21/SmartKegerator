# SmartKegerator systemd user service
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp smartkegerator.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smartkegerator
#
# Logs:
#   journalctl --user -u smartkegerator -f
#
# Adjust the paths below if you installed to a different location.

[Unit]
Description=SmartKegerator
Documentation=https://github.com/philsprojects/smartkegerator
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/smartkegerator/src
ExecStart=/usr/bin/python3 %h/smartkegerator/src/main.py %h/smartkegerator/src/config.yaml
Restart=on-failure
RestartSec=5

# Display access — covers both X11 and Wayland on Pi OS Bookworm
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U

# Give hardware access time to settle after login
ExecStartPre=/bin/sleep 3

[Install]
WantedBy=graphical-session.target
