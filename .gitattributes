# Normalize line endings
* text=auto

# All text source files must use LF on every platform.
# This prevents CRLF from breaking shebangs on Linux when
# files are edited on Windows and deployed to the Pi.
*.sh      text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.service text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
